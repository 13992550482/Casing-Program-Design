def calculate_ac_usm(rows, geological_formulas):
    """使用 AC_usm_FORMULAS['AC_usm']，为每一完整行计算纵波时差。

    输入 AC 单位：μs/ft；输出 AC_usm 单位：μs/m。
    原地更新 rows 内的字典，不进行舍入，不写入数据库。
    """
    formula = geological_formulas.get("AC_usm_FORMULAS", {}).get("AC_usm")
    if not isinstance(formula, str) or not formula.strip():
        raise ValueError("公式文件必须提供 AC_usm_FORMULAS['AC_usm'] 公式字符串")

    # 一次编译，全部完整行复用；计算表达式来自已有公式文件。
    compiled_formula = compile(formula, "<AC_usm公式>", "eval")
    for row in rows:
        row["AC_usm"] = eval(
            compiled_formula,
            {"__builtins__": {}},
            {"AC": row["AC"]},
        )
    return rows


def calculate_dt_s(rows, geological_formulas):
    """按岩性选择 DT_S 公式，按地质年代选择系数，计算横波时差。

    使用 DT_S_FORMULAS['formulas'] 和 ['coefficients'] 的原有结构。
    须先完成 AC_usm 计算；AC_usm 和计算结果 DT_S 的单位均为 μs/m。
    原地更新 rows，不进行舍入，不写数据库。
    岩性或年代未配置时，报出该行 MD 并停止计算。
    """
    if not rows:
        return rows

    config = geological_formulas.get("DT_S_FORMULAS", {})
    formula_groups = config.get("formulas", {})
    coefficient_sets = config.get("coefficients", {})
    if not formula_groups or not coefficient_sets:
        raise ValueError("DT_S_FORMULAS 必须提供 formulas 和 coefficients 配置")

    # 每个岩性组的公式只编译一次，同组岩性复用同一公式。
    compiled_by_lith = {}
    for lithologies, formula in formula_groups.items():
        compiled_formula = compile(formula, "<DT_S公式>", "eval")
        for lithology in lithologies:
            compiled_by_lith[lithology] = compiled_formula

    for row in rows:
        lithology = row["Lith"]
        geol_time = row["geol_time"]
        compiled_formula = compiled_by_lith.get(lithology)
        if compiled_formula is None:
            raise ValueError(
                f"MD={row['MD']}：岩性 {lithology!r} 未配置 DT_S 公式"
            )

        coefficients = coefficient_sets.get(geol_time)
        if coefficients is None:
            raise ValueError(
                f"MD={row['MD']}：地质年代 {geol_time!r} 未配置 DT_S 系数"
            )

        # 复制系数后加入当前行输入，不修改公式文件中的系数字典。
        variables = dict(coefficients)
        variables.update({"AC_usm": row["AC_usm"], "DEN": row["DEN"]})
        try:
            row["DT_S"] = eval(
                compiled_formula,
                {"__builtins__": {}, "exp": exp},
                variables,
            )
        except (ArithmeticError, NameError, TypeError, ValueError) as exc:
            raise ValueError(
                f"MD={row['MD']}，岩性={lithology!r}，年代={geol_time!r}："
                f"DT_S 公式计算失败：{exc}"
            ) from exc
    return rows


