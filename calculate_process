def select_stress_model():
    """由操作者在计算前选择水平主应力模型，输入无效时重新选择。"""
    print("请选择本次计算的水平主应力模型：")
    for number, model in enumerate(STRESS_MODELS, 1):
        print(f"  {number}. {model}")

    choices = {str(number): model for number, model in enumerate(STRESS_MODELS, 1)}
    while True:
        try:
            choice = input("请输入 1 或 2：").strip()
        except EOFError as exc:
            raise ValueError(
                "未完成模型选择，请通过交互菜单或 --stress-model 明确指定模型"
            ) from exc
        if choice in choices:
            return choices[choice]
        print("输入无效，请输入 1（六五模型）或 2（七五模型）。")


