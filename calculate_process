        if _is_missing(coefficients.get("ACma")):
            raise ValueError(
                f"MD={row['MD']}，地质年代={geol_time!r}："
                "ACma 尚未配置，请在 geomechanics_formulas.py 中填写后计算 Poro"
            )

        variables = dict(coefficients)
        variables["AC_usm"] = row["AC_usm"]
        try:
            row["Poro"] = eval(
                compiled_formula,
                {"__builtins__": {}},
                variables,
            )
        except (ArithmeticError, NameError, TypeError, ValueError) as exc:
            raise ValueError(
                f"MD={row['MD']}，地质年代={geol_time!r}："
                f"Poro 公式计算失败：{exc}"
            ) from exc
    return rows


def calculate_igr(rows, geological_formulas):
    """按地质年代统计完整行的 GR 极值，再使用配置公式计算 IGR。

    同一年代的全部完整行共用 GR_min、GR_max，不再按岩性或连续层段拆分。
    统计范围仅为当前井筛选后的完整行，不包含已跳过的不完整行。
    使用 VSH_FORMULAS['IGR']，结果原地保存在 row['IGR'] 中。
    某年代 GR 极值相等时明确报错，不代填 IGR。
    """
    if not rows:
        return rows

    formula = geological_formulas.get("VSH_FORMULAS", {}).get("IGR")
    if not isinstance(formula, str) or not formula.strip():
        raise ValueError("公式文件必须提供 VSH_FORMULAS['IGR'] 公式字符串")
    compiled_formula = compile(formula, "<IGR公式>", "eval")

    gr_ranges = {}
    for row in rows:
        geol_time = row["geol_time"]
        gr = row["GR"]
        gr_min, gr_max = gr_ranges.get(geol_time, (gr, gr))
        gr_ranges[geol_time] = (min(gr_min, gr), max(gr_max, gr))

    # 包括仅有一个完整点的年代；此时标准公式的分母也为零。
    for geol_time, (gr_min, gr_max) in gr_ranges.items():
        if gr_min == gr_max:
            raise ValueError(
                f"地质年代 {geol_time!r} 的完整行 GR_min = GR_max = {gr_min}，"
                "无法计算 IGR"
            )

    for row in rows:
        geol_time = row["geol_time"]
        gr_min, gr_max = gr_ranges[geol_time]
        variables = {"GR": row["GR"], "GR_min": gr_min, "GR_max": gr_max}
        try:
            row["IGR"] = eval(
                compiled_formula,
                {"__builtins__": {}},
                variables,
            )
        except (ArithmeticError, NameError, TypeError, ValueError) as exc:
            raise ValueError(
                f"MD={row['MD']}，地质年代={geol_time!r}："
                f"IGR 公式计算失败：{exc}"
            ) from exc
    return rows


