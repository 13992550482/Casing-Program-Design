def calculate_da(rows, geological_formulas):
    """按地质年代读取 DA_A、DA_B，使用 AC_usm 计算可钻性指数 Da。

    使用 Da_FORMULAS['formula'] 和 ['coefficients'] 的原有结构。
    公式中的 ln 对应 math.log，自然对数输入为单位 μs/m 的 AC_usm。
    原地更新 row['Da']，不截断、不舍入，不写数据库。
    年代、系数未配置或公式执行失败时，报出该行 MD 并停止。
    """
    if not rows:
        return rows

    config = geological_formulas.get("Da_FORMULAS", {})
    formula = config.get("formula")
    coefficient_sets = config.get("coefficients", {})
    if not isinstance(formula, str) or not formula.strip():
        raise ValueError("公式文件必须提供 Da_FORMULAS['formula'] 公式字符串")
    if not coefficient_sets:
        raise ValueError("Da_FORMULAS 必须提供 coefficients 配置")
    compiled_formula = compile(formula, "<Da公式>", "eval")

    for row in rows:
        geol_time = row["geol_time"]
        coefficients = coefficient_sets.get(geol_time)
        if coefficients is None:
            raise ValueError(
                f"MD={row['MD']}：地质年代 {geol_time!r} 未配置 Da 系数"
            )
        missing_coefficients = [
            name for name in ("DA_A", "DA_B")
            if _is_missing(coefficients.get(name))
        ]
        if missing_coefficients:
            raise ValueError(
                f"MD={row['MD']}，地质年代={geol_time!r}："
                + "、".join(missing_coefficients)
                + " 尚未配置"
            )

        variables = dict(coefficients)
        variables["AC_usm"] = row["AC_usm"]
        try:
            row["Da"] = eval(
                compiled_formula,
                {"__builtins__": {}, "ln": log},
                variables,
            )
        except (ArithmeticError, NameError, TypeError, ValueError) as exc:
            raise ValueError(
                f"MD={row['MD']}，地质年代={geol_time!r}："
                f"Da 公式计算失败：{exc}"
            ) from exc
    return rows


