# 【2】基础工具：模型选择 / 井表存在检查 / SQL 标识符 / 缺失值
# ==========================================================================

def check_well_exists(well_id, conn=None):
    """只检查数据库中是否存在与输入井号完全一致的数据表。"""
    close_conn = conn is None
    if close_conn:
        conn = get_connection()
    try:
        found = conn.execute(
            "SELECT 1 FROM sqlite_master "
            "WHERE type = 'table' AND name = ? COLLATE BINARY",
            (well_id,),
        ).fetchone()
        if found is None:
            raise ValueError(f"邻井数据库中不存在井号对应的数据表：{well_id}")
        return well_id
    finally:
        if close_conn:
            conn.close()


def _quote_identifier(name):
    """安全引用 SQLite 标识符，兼容中文、空格和双引号。"""
    return '"' + name.replace('"', '""') + '"'


def _is_missing(value):
    """NULL、空字符串及纯空白字符串视为缺失；数值 0 有效。"""
    return value is None or (
        isinstance(value, str) and not value.strip()
    )


# ==========================================================================
# 【3】第0步：按井号从数据库读取完整行
# ==========================================================================

def read_complete_well_data(well_id):
    """按 MD 升序读取指定井的数据，只返回必需字段完整的行。

    任一必需字段缺失时，整行跳过。保留数据库中的原始字段值，
    不进行数值范围检查、单位转换、补值或分类名称转换。

    Returns
    -------
    dict
        well_id: 在数据库中找到的井表名称。
        rows: 完整行组成的字典列表，按 MD 升序排列。
        total_count: 该井读取的总行数。
        complete_count: 完整行数。
        skipped_count: 因字段缺失而跳过的行数。

    空井表或全部行不完整时，rows 返回空列表。
    数据库不存在、井表不存在或缺少必需列时，抛出异常。
    """
    conn = get_connection()

    try:
        well_id = check_well_exists(well_id, conn)
        quoted_table = _quote_identifier(well_id)

        columns = {
            row["name"]
            for row in conn.execute(f"PRAGMA table_info({quoted_table})")
        }
        missing_columns = [
            field for field in REQUIRED_FIELDS if field not in columns
        ]
        if missing_columns:
            raise ValueError(
                f"井表 {well_id} 缺少必需字段："
                + ", ".join(missing_columns)
            )

        selected_fields = ", ".join(
            _quote_identifier(field) for field in REQUIRED_FIELDS
        )
        cursor = conn.execute(
            f"SELECT {selected_fields} FROM {quoted_table} ORDER BY MD ASC"
        )

        complete_rows = []
        total_count = 0
        for row in cursor:
            total_count += 1
            if any(_is_missing(row[field]) for field in REQUIRED_FIELDS):
                continue
            complete_rows.append(dict(row))

    finally:
        # sqlite3 连接的事务上下文不会自动关闭连接，这里显式关闭。
        conn.close()

    complete_count = len(complete_rows)
    return {
        "well_id": well_id,
        "rows": complete_rows,
        "total_count": total_count,
        "complete_count": complete_count,
        "skipped_count": total_count - complete_count,
    }


