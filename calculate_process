def calculate_horizontal_stress(rows, stress_formulas, stress_model):
    """按已选模型计算 SHmax、Shmin，使用配置中的 beta_H、beta_h。

    从 HORIZONTAL_STRESS_FORMULAS[stress_model] 读取两条公式，
    从 HORIZONTAL_STRESS_FORMULAS['coefficients'] 读取构造应力系数。
    六五模型使用 NU_S、Over_P、BIOT、P_p；七五模型额外使用 E_S。
    保留七五模型公式内部的 E_S * 1000，不在主程序额外换算。
    原地更新 row['SHmax']、row['Shmin']，不舍入，不写数据库。
    """
    if stress_model not in STRESS_MODELS:
        raise ValueError("水平主应力计算必须明确选择 '六五模型' 或 '七五模型'")
    if not rows:
        return rows

    config = stress_formulas.get("HORIZONTAL_STRESS_FORMULAS", {})
    model_formulas = config.get(stress_model)
    if not isinstance(model_formulas, dict):
        raise ValueError(f"HORIZONTAL_STRESS_FORMULAS 未配置 {stress_model!r}")

    compiled_formulas = {}
    for field in ("SHmax", "Shmin"):
        formula = model_formulas.get(field)
        if not isinstance(formula, str) or not formula.strip():
            raise ValueError(f"模型 {stress_model!r} 必须提供 {field} 公式字符串")
        compiled_formulas[field] = compile(formula, f"<{stress_model}:{field}公式>", "eval")

    coefficients = config.get("coefficients", {})
    missing_coefficients = [
        name for name in ("beta_H", "beta_h")
        if _is_missing(coefficients.get(name))
    ]
    if missing_coefficients:
        raise ValueError(
            f"模型 {stress_model!r} 的 "
            + "、".join(missing_coefficients)
            + " 尚未配置，请在 stress_formulas.py 中填写构造应力系数"
        )

    for row in rows:
        variables = dict(coefficients)
        try:
            variables.update({
                "NU_S": row["NU_S"],
                "Over_P": row["Over_P"],
                "BIOT": row["BIOT"],
                "P_p": row["P_p"],
            })
            if stress_model == "七五模型":
                variables["E_S"] = row["E_S"]

            # 两个结果均成功后再更新当前行，避免留下单侧计算结果。
            values = {}
            for field, compiled_formula in compiled_formulas.items():
                values[field] = eval(
                    compiled_formula,
                    {"__builtins__": {}},
                    variables,
                )
        except (ArithmeticError, KeyError, NameError, TypeError, ValueError) as exc:
            raise ValueError(
                f"MD={row['MD']}，模型={stress_model!r}：水平主应力计算失败：{exc}"
            ) from exc
        row.update(values)
    return rows


