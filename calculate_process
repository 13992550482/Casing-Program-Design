    parser = argparse.ArgumentParser(description="读取邻井数据，计算参数并写回数据库")
    parser.add_argument(
        "well_id", nargs="?", default=None,
        help="临时指定数据库井号；省略时使用顶部 WELL_ID",
    )
    parser.add_argument(
        "--stress-model", choices=STRESS_MODELS,
        help="临时指定模型；省略时使用 DEFAULT_STRESS_MODEL 或交互选择",
    )
    args = parser.parse_args()

    well_id = args.well_id if args.well_id is not None else WELL_ID
    stress_model = args.stress_model or DEFAULT_STRESS_MODEL
