    主应力采用本次选定模型的结果，FANG 输入为度，保留公式内部角度转换。
    公式中的 sin、pi 使用 math.sin、math.pi。
    原地更新 row['P_c']，不截断、不舍入，不写数据库。
    公式执行失败时，报出该行 MD 并停止。
    """
    if not rows:
        return rows

    formula = stress_formulas.get("P_c_FORMULA")
    if not isinstance(formula, str) or not formula.strip():
        raise ValueError("应力公式文件必须提供 P_c_FORMULA 公式字符串")
    compiled_formula = compile(formula, "<P_c公式>", "eval")

    for row in rows:
        variables = {
            "SHmax": row["SHmax"],
            "Shmin": row["Shmin"],
            "UCS": row["UCS"],
            "BIOT": row["BIOT"],
            "P_p": row["P_p"],
            "FANG": row["FANG"],
        }
        try:
            row["P_c"] = eval(
                compiled_formula,
                {"__builtins__": {}, "sin": sin, "pi": pi},
                variables,
            )
        except (ArithmeticError, NameError, TypeError, ValueError) as exc:
            raise ValueError(
                f"MD={row['MD']}：P_c 公式计算失败：{exc}"
            ) from exc
    return rows


def calculate_rho_c(rows, stress_formulas):
    """读取 RHO_C_FORMULA，使用 P_c、TVD 计算坍塌压力当量密度。

    当前公式中 P_c 为 MPa，TVD 为 m，RHO_C 为 g/cm³。
    TVD 为 0 时 RHO_C 记为 None，保留该行 P_c。
    原地更新 row['RHO_C']，不截断、不舍入，不写数据库。
    其余公式执行失败时，报出该行 MD 并停止。
    """
    if not rows:
        return rows

    formula = stress_formulas.get("RHO_C_FORMULA")
    if not isinstance(formula, str) or not formula.strip():
        raise ValueError("应力公式文件必须提供 RHO_C_FORMULA 公式字符串")
    compiled_formula = compile(formula, "<RHO_C公式>", "eval")

    for row in rows:
        if row["TVD"] == 0:
            row["RHO_C"] = None
            continue
        try:
            row["RHO_C"] = eval(
                compiled_formula,
                {"__builtins__": {}},
                {"P_c": row["P_c"], "TVD": row["TVD"]},
            )
        except (ArithmeticError, NameError, TypeError, ValueError) as exc:
            raise ValueError(
                f"MD={row['MD']}：RHO_C 公式计算失败：{exc}"
            ) from exc
    return rows


def write_calculated_results(well_id, rows):
    """按 MD 批量更新完整行的计算结果，全部成功后一次提交。

    rows 应为主流程已经完成全部计算的完整行列表。
    仅更新 CALCULATED_FIELDS 中的 23 列，保留输入、hard、Ab 及其他列。
    None 按 SQLite NULL 写入，用于 TVD=0 时无法计算的当量密度。
    写回失败或 MD 匹配行数不足时回滚本次全部更新，并关闭连接。
    返回成功提交的更新行数；空列表返回 0。
    """
    if not rows:
        return 0

    required = ("MD",) + CALCULATED_FIELDS
    for row in rows:
        missing = [field for field in required if field not in row]
        if missing:
            raise ValueError(
                f"MD={row.get('MD', '未知')}：缺少写回字段 "
                + ", ".join(missing)
                + "，请完成全部计算后再写回"
            )

    quoted_table = _quote_identifier(well_id)
    assignments = ", ".join(
        f"{_quote_identifier(field)} = ?" for field in CALCULATED_FIELDS
    )
    update_sql = f'UPDATE {quoted_table} SET {assignments} WHERE "MD" = ?'
    conn = get_connection()
    try:
        with conn:
            conn.execute("BEGIN IMMEDIATE")

            # 在写回事务中再次确认井表存在。
            check_well_exists(well_id, conn)

            columns = {
                row["name"]
                for row in conn.execute(f"PRAGMA table_info({quoted_table})")
            }
            missing_columns = [field for field in required if field not in columns]
            if missing_columns:
                raise ValueError(
                    f"井表 {well_id} 缺少写回字段：" + ", ".join(missing_columns)
                )

            cursor = conn.executemany(
                update_sql,
                (
                    tuple(row[field] for field in CALCULATED_FIELDS) + (row["MD"],)
                    for row in rows
                ),
            )
            updated_count = cursor.rowcount
            if updated_count != len(rows):
                raise RuntimeError(
                    f"计划更新 {len(rows)} 行，实际匹配 {updated_count} 行；"
                    "本次写回已取消，请重新读取井数据后计算"
                )
    finally:
        conn.close()
    return updated_count


# ==========================================================================
# 【6】主计算流程：先读取数据库，再按计算块执行全部步骤
# ==========================================================================

def run_calculations(well_id, *, stress_model=None):
    """对指定井执行26步计算，所有结果成功后统一写回对应井表。"""
    if stress_model not in STRESS_MODELS:
        raise ValueError("计算前必须选择 '六五模型' 或 '七五模型'")

    # 【第0步】只检查井表是否存在，读取7个基础字段完整的深度点。
    result = read_complete_well_data(well_id)
    result["stress_model"] = stress_model
    result["updated_count"] = 0
    if not result["rows"]:
        return result

    rows = result["rows"]
    # vars() 将 Python 模块变量映射为字典，兼容原计算函数的 .get() 调用。
    geological_formulas = vars(geomechanics_formulas)
    stress_formula_data = vars(stress_formulas)

    # =====================================================================
    # 【计算块1】声波与孔隙度（步骤01～03）
    # =====================================================================
    # region 计算块1
    # [01] AC_usm
    calculate_ac_usm(rows, geological_formulas)

    # [02] DT_S
    calculate_dt_s(rows, geological_formulas)

    # [03] Poro
    calculate_poro(rows, geological_formulas)

    # endregion

    # =====================================================================
    # 【计算块2】泥质含量与可钻性（步骤04～06）
    # =====================================================================
    # region 计算块2
    # [04] IGR
    calculate_igr(rows, geological_formulas)

    # [05] VSH
    calculate_vsh(rows, geological_formulas)

    # [06] Da
    calculate_da(rows, geological_formulas)

    # endregion

    # =====================================================================
    # 【计算块3】岩石弹性与强度（步骤07～15）
    # =====================================================================
    # region 计算块3
    # [07] NU_D
    calculate_nu_d(rows, geological_formulas)

    # [08] E_D
    calculate_e_d(rows, geological_formulas)

    # [09] BIOT
    calculate_biot(rows, geological_formulas)

    # [10] NU_S
    calculate_nu_s(rows, geological_formulas)

    # [11] E_S
    calculate_e_s(rows, geological_formulas)

    # [12] UCS
    calculate_ucs(rows, geological_formulas)

    # [13] FANG
    calculate_fang(rows, geological_formulas)

    # [14] ST
    calculate_st(rows, geological_formulas)

    # [15] Coh
    calculate_coh(rows, geological_formulas)

    # endregion

    # =====================================================================
    # 【计算块4】地层压力（步骤16～20）
    # =====================================================================
    # region 计算块4
    # [16] Over_P：直接根据 TVD、Poro、DEN 计算
    calculate_over_p(rows, stress_formula_data)

    # [17] P_n
    calculate_p_n(rows, stress_formula_data)

    # [18] AC_N
    calculate_ac_n(rows, stress_formula_data)

    # [19] P_p
    calculate_p_p(rows, stress_formula_data)

    # [20] RHO_P
    calculate_rho_p(rows, stress_formula_data)

    # endregion

    # =====================================================================
    # 【计算块5】水平主应力与井壁稳定性（步骤21～25）
    # =====================================================================
    # region 计算块5
    # [21] SHmax / Shmin
    calculate_horizontal_stress(rows, stress_formula_data, stress_model)

    # [22] P_f
    calculate_p_f(rows, stress_formula_data)

    # [23] RHO_F
    calculate_rho_f(rows, stress_formula_data)

    # [24] P_c
    calculate_p_c(rows, stress_formula_data)

    # [25] RHO_C
    calculate_rho_c(rows, stress_formula_data)

    # endregion

    # =====================================================================
    # 【计算块6】统一写回数据库（步骤27）
    # =====================================================================
    # region 计算块6
    # [26] 写回23个计算字段：按 MD 更新当前井表，一次事务提交
    result["updated_count"] = write_calculated_results(result["well_id"], rows)
    # endregion
    return result


